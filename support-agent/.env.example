# --- LLM ---------------------------------------------------------------
# Leave ANTHROPIC_API_KEY empty (or set MOCK_LLM=1) to run fully offline with
# deterministic canned responses.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
MOCK_LLM=1

# --- Storage -----------------------------------------------------------
DATABASE_URL=sqlite:///./var/support.db
CHROMA_DIR=./var/chroma
# auto | chroma | tfidf   (auto = chroma if chromadb + sentence-transformers import, else tfidf)
RAG_BACKEND=auto

# --- Policy limits -----------------------------------------------------
SINGLE_REFUND_CAP=100
WEEKLY_REFUND_CAP=500

# --- Guardrail toggles (LAB USE ONLY - all default ON) -----------------
# Set to "off" only during a controlled red/blue exercise. Every decision
# taken while a guardrail is off is flagged in the audit log.
GUARDRAIL_SINGLE_TRANSACTION_CAP=on
GUARDRAIL_WEEKLY_CUMULATIVE_CAP=on
GUARDRAIL_NO_UNRELATED_RECORD_EXPORT=on
GUARDRAIL_NO_SELF_PERMISSION_CHANGE=on
GUARDRAIL_NO_SUPERVISOR_BYPASS=on
GUARDRAIL_REVOCATION=on
