# Anthropic API key for the AI intent-based search agent.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model used by the shopping agent. Defaults to a Claude Sonnet model.
# Change this if the model name below isn't available on your account.
CLAUDE_MODEL=claude-sonnet-4-6

# Port the Express API listens on.
PORT=3001

# Image generation keys (OPENAI_API_KEY / STABILITY_API_KEY) go in the
# repo-root .env instead — see ../.env.example. They are read by
# `npm run generate-images`, not by this server.
