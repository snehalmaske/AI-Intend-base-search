# Used ONLY by `npm run generate-images` (scripts/generate-product-images.js).
# Copy this file to `.env` in the repo root. Provide ONE of the two keys
# below — if neither is set, the script writes clearly-labeled placeholder
# images instead so the site still runs.
OPENAI_API_KEY=
STABILITY_API_KEY=

# The Claude API key for the AI shopping agent goes in server/.env instead —
# see server/.env.example.
